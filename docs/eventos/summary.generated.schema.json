{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "summary.generated",
  "$defs": {
    "SummaryGeneratedData": {
      "additionalProperties": false,
      "properties": {
        "summary_id": {
          "minLength": 1,
          "title": "Summary Id",
          "type": "string"
        },
        "channel_id": {
          "minLength": 1,
          "title": "Channel Id",
          "type": "string"
        },
        "requested_by": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Quién lo pidió; sirve para saber a quién avisar.",
          "title": "Requested By"
        },
        "messageState": {
          "const": "completada",
          "title": "Messagestate",
          "type": "string"
        }
      },
      "required": [
        "summary_id",
        "channel_id",
        "requested_by",
        "messageState"
      ],
      "title": "SummaryGeneratedData",
      "type": "object"
    }
  },
  "additionalProperties": false,
