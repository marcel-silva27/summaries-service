  "examples": [
    {
      "data": {
        "channel_id": "84e015c1-ed09-470c-b584-6f6210ea219c",
        "messageState": "completada",
        "requested_by": null,
        "summary_id": "08ac19f0-b81f-413c-be12-416d99f2672d"
      },
      "occurred_at": "2026-10-19T05:15:00.456000+00:00",
      "subject_id": "08ac19f0-b81f-413c-be12-416d99f2672d",
      "type": "summary.generated"
    }
  ],
  "properties": {
    "subject_id": {
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "type": {
      "const": "summary.generated",
      "title": "Type",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/SummaryGeneratedData"
    }
  },
  "required": [
    "subject_id",
    "occurred_at",
    "type",
    "data"
  ],
  "type": "object"
