      },
      "occurred_at": "2026-10-19T05:20:00+00:00",
      "subject_id": "84e015c1-ed09-470c-b584-6f6210ea219c",
      "type": "chat.channel.entered"
    }
  ],
  "properties": {
    "subject_id": {
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "type": {
      "const": "chat.channel.entered",
      "title": "Type",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/ChannelEntry"
    }
  },
  "required": [
    "subject_id",
    "occurred_at",
    "type",
    "data"
  ],
  "type": "object"
