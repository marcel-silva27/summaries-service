      "description": "Entrada de un usuario a un canal, publicada por el Gateway (`chat.channel.entered`).",
      "properties": {
        "channel_id": {
          "minLength": 1,
          "title": "Channel Id",
          "type": "string"
        },
        "user_id": {
          "minLength": 1,
          "title": "User Id",
          "type": "string"
        },
        "entry_id": {
          "minLength": 1,
          "title": "Entry Id",
          "type": "string"
        }
      },
      "required": [
        "channel_id",
        "user_id",
        "entry_id"
      ],
      "title": "ChannelEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
