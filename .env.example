# Persistencia propia (Docker Compose sobrescribe MONGODB_URL)
MONGODB_URL=mongodb://summaries-mongodb:27017
MONGODB_DATABASE=summaries
MONGODB_TIMEOUT_MS=5000

# Broker: compartido con messages; sin puertos publicados al host
BROKER_URL=amqp://summaries-rabbitmq:5672
BROKER_TIMEOUT_SECONDS=2
BROKER_RETRY_SECONDS=1
# Respaldo del aviso inmediato de la outbox (segundos)
OUTBOX_POLL_SECONDS=5

# Núcleo del chat (puerto interno 8000 dentro de la red microsvcs)
USERS_URL=http://users:8000
CHANNELS_URL=http://channels:8000
MESSAGES_URL=http://messages:8000

# LLM: mock (desarrollo/pruebas) o gemini. LLM_API_KEY va SOLO en .env (ignorado por git);
# para usar Gemini define en .env: LLM_PROVIDER=gemini, LLM_API_KEY, LLM_MODEL y LLM_FALLBACK_MODEL.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta
LLM_TIMEOUT_SECONDS=60
LLM_RETRY_MAX_WAIT_SECONDS=10
# Ventana enviada al LLM (lo que ocurra primero)
LLM_MAX_DAYS=7
LLM_MAX_MESSAGES=500
LLM_MAX_INPUT_CHARS=400000

# Worker de generación
WORKER_POLL_SECONDS=5
WORKER_RETRY_SECONDS=5
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=3

# Resumen automático
MESSAGE_THRESHOLD=50
CORE_TIMEOUT_SECONDS=2
